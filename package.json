{
  "name": "hive-writing-prototype",
  "private": true,
  "version": "0.1.9",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "npm run build:backend && node server/index.mjs",
    "start": "node server/index.mjs --production",
    "build": "node scripts/build-runtime.mjs",
    "build:backend": "node scripts/build-runtime.mjs backend",
    "test": "npm run build:backend && vitest run",
    "desktop": "npm run build && electron .",
    "desktop:dev": "npm run build:backend && node scripts/desktop-dev.mjs",
    "desktop:folder": "node scripts/build-runtime.mjs dir",
    "verify:app": "node scripts/verify-app.mjs",
    "verify:package": "node scripts/verify-release.mjs",
    "update:bundle": "node scripts/make-local-update.mjs",
    "desktop:portable": "node scripts/build-runtime.mjs portable"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/common": "1.5.5",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "1.8.1",
    "express": "^5.1.0",
    "katex": "0.19.1",
    "lucide-react": "^0.468.0",
    "mermaid": "12.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "local.hive.writing",
    "productName": "HIVE markdown editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "shared/**",
      "assets/brand/hive.png",
      "LICENSE",
      "!**/*.test.*",
      "!**/node_modules/**",
      "!desktop/localDocuments.mjs",
      "!desktop/preferences.cjs",
      "!desktop/templateSource.cjs",
      "!desktop/localUpdate.cjs",
      "!desktop/internetUpdate.cjs",
      "!desktop/applyLocalUpdate.cjs",
      "!desktop/about.cjs",
      "!desktop/buildMetadata.cjs",
      "package.json"
    ],
    "win": {
      "icon": "assets/brand/hive.ico",
      "target": [
        "portable"
      ]
    }
  }
}
